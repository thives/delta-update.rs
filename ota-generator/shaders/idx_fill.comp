#version 450
#extension GL_GOOGLE_include_directive : enable
// Copy-source tables, step 1: one entry {hash, position} per sampled position of an image, and
// padding entries that sort last. Push constant a0 selects the table: 0 is the old image, 1 the
// new image. The hash is the polynomial hash of the PROBE bytes from the position.
#include "layout.glsl"
#include "common.glsl"

void main() {
    images_init();
    bool tgt = pc.a0 != 0u;
    uint cap = tgt ? P(P_NEW_CAP) : P(P_OLD_CAP);
    uint entries = tgt ? P(P_NEW_ENTRIES) : P(P_OLD_ENTRIES);
    uint base = tgt ? P(P_NEW_TABLE) : P(P_OLD_TABLE);
    uint stride = P(P_IDX_STRIDE);
    uint step = gl_NumWorkGroups.x * uint(WORKGROUP);
    for (uint i = gl_GlobalInvocationID.x; i < cap; i += step) {
        if (i >= entries) {
            ix[base + 2u * i] = 0xFFFFFFFFu;
            ix[base + 2u * i + 1u] = 0xFFFFFFFFu;
            continue;
        }
        uint x = i * stride;
        uint h = 0u;
        for (uint k = 0u; k < uint(PROBE); k++) {
            h = h * uint(HASH_BASE) + (tgt ? new_byte(x + k) : old_byte(x + k));
        }
        ix[base + 2u * i] = h;
        ix[base + 2u * i + 1u] = x;
    }
}
